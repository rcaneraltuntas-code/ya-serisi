  "SON İNSAN SEN OLSAYDIN?"
 ],
 "voice": {
  "id": "vwmWyMlmlJtiiXeCVRKn",
  "model": "eleven_v4",
  "via": "ElevenLabs connector",
  "direction": "eleven_v4 ses etiketleriyle oyunculuk: fısıltı, gerginlik, titreyen ses, nefes"
 },
 "script": [
  {
   "beat": "yatak odası",
   "text": "Uyanıyorsun. Sokakta tek bir ses yok."
  },
  {
   "beat": "mutfak",
   "text": "Annen yok. Kahvesi masada. Hâlâ sıcak."
  },
  {
   "beat": "sokak",
   "text": "Dışarı çıkıyorsun. Arabalar yolun ortasında. Kapıları açık. Motorları çalışıyor. Sekiz milyar insan. Hiçbiri yok."
  },
  {
   "beat": "başlık",
   "text": "Ya dünyada kalan son insan sen olsaydın?"
  },
  {
   "beat": "market",
   "text": "Markete giriyorsun. Kasada kimse yok. Güvenlik kamerasının kaydını açıyorsun."
  },
  {
   "beat": "kayıt",
   "text": "Saat üç on yedi. Kayıttaki herkes aynı anda duruyor. Hepsi başını kaldırıp aynı yöne bakıyor. Sonra görüntü kararıyor."
  },
  {
   "beat": "ters köşe",
   "text": "Geri sarıyorsun. Bir daha izliyorsun. Herkes yukarı bakıyor. Bir kişi hariç. O, kameraya bakıyor. O sensin."
  },
  {
   "beat": "kanca",
   "text": "Sonra cebindeki telefon çalıyor. Arayan: Sen."
  }
 ],
